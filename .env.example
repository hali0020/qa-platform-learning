# Safe template for the repository-root .env file.  The populated .env is the
# only manually maintained file for reusable local connection settings and
# ordinary lab credentials; it must never be committed. Do not create a second
# frontend environment file. Runtime data and short-lived bootstrap material
# stay in their dedicated ignored/ACL-protected storage instead.
APP_NAME=qa-platform-learning
APP_ENV=local
DEBUG=false
AUTH_ENABLED=true
METRICS_ENABLED=true
REQUEST_LOGGING_ENABLED=true

# Source mode and the default Compose topology both use project-local SQLite.
# These paths are generic project paths, not personal connection information.
DATABASE_RUNTIME_MODE=sqlite_local
DATABASE_URL=sqlite+aiosqlite:///./.data/qa.db
LOCAL_DATA_ROOT=./.data
COMPOSE_DATABASE_RUNTIME_MODE=sqlite_local
COMPOSE_DATABASE_URL=sqlite+aiosqlite:////data/qa.db

# Optional Redis cache. It stores derived project list/detail JSON only;
# PostgreSQL/SQLite remains authoritative and requests fail open to the DB.
COMPOSE_CACHE_RUNTIME_MODE=redis_local_container
COMPOSE_CACHE_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60
CACHE_OPERATION_TIMEOUT_SECONDS=0.2

# Optional project-owned PostgreSQL profile.  Keep passwords only in .env.
POSTGRES_DB=qa_platform_learning
POSTGRES_USER=qa_platform_learning
POSTGRES_PASSWORD=
# COMPOSE_DATABASE_RUNTIME_MODE=postgres_local_container
# COMPOSE_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Optional profile secrets stay blank until that project-owned profile is used.
RABBITMQ_DEFAULT_USER=qa_platform_learning
RABBITMQ_DEFAULT_PASS=
# When enabling the broker, put the complete AMQP URL here and percent-encode
# reserved characters in its username/password. Keep the real value in the
# ignored .env; do not derive it by concatenating RABBITMQ_DEFAULT_PASS.
COMPOSE_BROKER_URL=
WORKER_QUEUES=default
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10
WORKER_POLL_SECONDS=5
OUTBOX_LEASE_SECONDS=30
OUTBOX_POLL_SECONDS=2
SCHEDULER_LEASE_SECONDS=30
SCHEDULER_POLL_SECONDS=5
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=qa-bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
VAULT_APP_TOKEN=
QA_PROVIDER_SECRET_CI_LAB=
QA_PROVIDER_SECRET_CI_LAB_WEBHOOK=

# Safe defaults for the attachment storage boundary. Credential and endpoint
# values intentionally remain blank in the tracked template.
OBJECT_STORAGE_RUNTIME_MODE=local_filesystem
COMPOSE_OBJECT_STORAGE_RUNTIME_MODE=local_filesystem
COMPOSE_OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=
COMPOSE_OBJECT_STORAGE_BUCKET=
# COMPOSE_OBJECT_STORAGE_BUCKET=qa-artifacts
OBJECT_STORAGE_REGION=us-east-1

# Optional identity, Vault and Provider labs are default-off. Add only values
# for services that you installed yourself inside the isolated learning lab.
COMPOSE_AUTH_RUNTIME_MODE=local_accounts
COMPOSE_OIDC_ISSUER=
COMPOSE_OIDC_BROWSER_AUTHORIZATION_ENDPOINT=
COMPOSE_OIDC_TOKEN_ENDPOINT=
COMPOSE_OIDC_JWKS_ENDPOINT=
COMPOSE_OIDC_CLIENT_ID=
COMPOSE_OIDC_REDIRECT_URI=
COMPOSE_OIDC_POST_LOGIN_REDIRECT_URI=
COMPOSE_SECRET_STORE_RUNTIME_MODE=env_local
COMPOSE_VAULT_ENDPOINT_URL=
COMPOSE_VAULT_KV_MOUNT=
COMPOSE_VAULT_APP_TOKEN_FILE=
COMPOSE_PROVIDER_RUNTIME_MODE=local_lab
COMPOSE_PROVIDER_SECRET_ENV_ALLOWLIST=

# Other connection strings, service addresses, usernames, passwords, tokens
# and provider settings must be supplied only through the untracked root .env
# or an external secret store.
